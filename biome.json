{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"**",
			"!**/node_modules/**/*",
			"!**/dist/**/*",
			"!**/lib/**/*",
			"!**/playwright/.cache/**/*",
			"!**/.next/**/*"
		]
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded",
			"quoteStyle": "single",
			"trailingCommas": "none"
		},
		"jsxRuntime": "reactClassic"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": "error",
			"correctness": {
				"useImportExtensions": "off",
				"noUnusedVariables": "error"
			},
			"security": "error",
			"performance": "error"
		}
	}
}
