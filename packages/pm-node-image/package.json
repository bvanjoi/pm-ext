{
	"name": "@pm-ext/node-image",
	"version": "0.0.1",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/index.js"
		},
		"./view/default-placeholder": {
			"types": "./dist/src/view/default-placeholder.d.ts",
			"default": "./dist/view/default-placeholder.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/src/index.d.ts",
	"scripts": {
		"build": "rm -rf dist && rslib build",
		"dev": "rslib build -w",
		"format:check": "biome format",
		"format:fix": "biome format --fix",
		"test": "playwright clear-cache && playwright test"
	},
	"dependencies": {
		"@pm-ext/pm-utils": "workspace:*",
		"@pm-ext/utils": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@pm-ext/basic-setup": "workspace:*",
		"@pm-ext/e2e-helper": "workspace:*",
		"@pm-ext/test-helper": "workspace:*",
		"@rslib/core": "^0.19.1",
		"@types/jsdom": "^27.0.0",
		"jsdom": "^27.4.0",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-history": "^1.5.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.4",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.4",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"prosemirror-state": "^1.0.0",
		"prosemirror-view": "^1.0.0"
	}
}
